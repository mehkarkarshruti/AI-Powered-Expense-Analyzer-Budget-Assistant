@{
    ViewData["Title"] = "Analytics";
}

<div class="dashboard">

    <div class="page-heading">
        <div>
            <h1>Analytics</h1>
            <p>Understand where your money is going.</p>
        </div>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-card spending-card">

            <div class="section-header">
                <div>
                    <h3>Daily Spending</h3>
                    <p>@ViewBag.MonthLabel</p>
                </div>
            </div>

            @if ((bool)ViewBag.HasExpenses)
            {
                <div class="bar-chart">
                    @foreach (var bar in (List<(int Day, decimal Total, int Height)>)ViewBag.DayBars)
                    {
                        <div class="bar-column"
                             title="@bar.Day @ViewBag.MonthLabel.Split(' ')[0]: ₹@bar.Total">
                            <div class="bar @(bar.Height > 0 ? "" : "empty")"
                                 style="height:@(Math.Max(bar.Height, 2))%"></div>
                            <span>@(bar.Day % 5 == 0 || bar.Day == 1 ? bar.Day.ToString() : "")</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="empty-state">No expenses recorded this month yet.</p>
            }

        </div>

        <div class="dashboard-card">

            <div class="section-header">
                <div>
                    <h3>Category Spending</h3>
                    <p>This month's breakdown</p>
                </div>
            </div>

            @if (ViewBag.CategoryTotals is not null &&
                 ((List<(string Name, string Amount, int Pct)>)ViewBag.CategoryTotals).Count > 0)
            {
                <div class="category-list">

                    @foreach (var row in (List<(string Name, string Amount, int Pct)>)ViewBag.CategoryTotals)
                    {
                        <div class="category-row">
                            <div class="category-name">
                                <span class="category-dot"></span>
                                @row.Name
                            </div>
                            <strong>@row.Amount</strong>
                        </div>

                        <div class="progress">
                            <div style="width:@(row.Pct)%"></div>
                        </div>
                    }

                </div>
            }
            else
            {
                <p class="empty-state">No category data yet.</p>
            }

        </div>

    </div>

</div>
