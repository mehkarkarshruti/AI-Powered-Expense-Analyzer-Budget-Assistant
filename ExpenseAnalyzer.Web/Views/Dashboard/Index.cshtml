@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">

    <div class="page-heading">
        <div>
            <h1>Welcome back, @ViewBag.UserName</h1>
            <p>Here is your spending overview.</p>
        </div>

        <button class="primary-btn" onclick="window.location.href='/Expense'">
            + Add Expense
        </button>
    </div>

    <!-- SUMMARY -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="card-top">
                <span>Total Spent</span>
                <div class="card-icon purple">₹</div>
            </div>
            <h2 id="totalSpent">@ViewBag.TotalSpent</h2>
            <p>This month</p>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Monthly Budget</span>
                <div class="card-icon blue">₹</div>
            </div>
            <h2 id="budgetAmount">@ViewBag.BudgetAmount</h2>
            <p><button class="mini-link" onclick="openBudgetModal()">Update budget</button></p>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Remaining</span>
                <div class="card-icon green">✓</div>
            </div>
            <h2 id="remainingAmount">@ViewBag.Remaining</h2>
            <p id="budgetPercentage"></p>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Daily Average</span>
                <div class="card-icon orange">↗</div>
            </div>
            <h2 id="dailyAverage">@ViewBag.DailyAverage</h2>
            <p>@ViewBag.TransactionCount transactions · top: @ViewBag.TopCategory</p>
        </div>

    </div>

    <!-- CATEGORY + AI -->
    <div class="dashboard-grid">

        <div class="dashboard-card">

            <div class="section-header">
                <div>
                    <h3>Category Breakdown</h3>
                    <p>Where your money goes</p>
                </div>
            </div>

            @if (ViewBag.Breakdown is not null && ((List<(string Name, string Amount, int Pct)>)ViewBag.Breakdown).Count > 0)
            {
                <div class="category-list">
                    @foreach (var row in (List<(string Name, string Amount, int Pct)>)ViewBag.Breakdown)
                    {
                        <div class="category-row">
                            <div class="category-name">
                                <span class="category-dot"></span>
                                @row.Name
                            </div>
                            <strong>@row.Amount</strong>
                        </div>
                        <div class="progress"><div style="width:@(row.Pct)%"></div></div>
                    }
                </div>
            }
            else
            {
                <p class="empty-state">No expenses recorded yet. Add your first expense to see the breakdown.</p>
            }

        </div>

    </div>

    <!-- AI + BUDGET -->
    <div class="bottom-grid">

        <div class="prediction-card">

            <div class="prediction-header">
                <div class="prediction-icon">🔮</div>

                <div>
                    <h3>AI Spending Prediction</h3>
                    <p>Based on your current spending pattern</p>
                </div>
            </div>

            <div class="prediction-value">
                <span>Expected monthly spending</span>
                <strong>@ViewBag.Predicted</strong>
            </div>

            @if ((bool)ViewBag.HasPrediction)
            {
                <div class="prediction-warning">
                    ⚠ You may exceed your current budget by
                    <strong id="predictionDifference">@ViewBag.PredictionDifference</strong>.
                </div>
            }
            else
            {
                <div class="prediction-warning">
                    No prediction available yet.
                </div>
            }

        </div>

        <div class="alert-card">

            <div class="alert-header">
                <div class="alert-icon">!</div>

                <div>
                    <h3>Budget Progress</h3>
                    <p>Track your monthly spending limit.</p>
                </div>
            </div>

            <div class="budget-progress">
                <div id="budgetProgress" style="width:83%"></div>
            </div>

            <div class="budget-labels">
                <span id="spentLabel">@ViewBag.TotalSpent spent</span>
                <span id="budgetLabel">@ViewBag.BudgetAmount budget</span>
            </div>

            <button class="budget-update-btn" onclick="openBudgetModal()">
                Update Monthly Budget
            </button>

        </div>

    </div>

</div>

<!-- BUDGET MODAL -->

<div class="expense-modal" id="budgetModal">

    <div class="modal-box">

        <div class="modal-header">

            <div>
                <h2>Update Budget</h2>
                <p>Set your monthly spending limit.</p>
            </div>

            <button class="close-btn" onclick="closeBudgetModal()">×</button>

        </div>

        <form onsubmit="updateBudget(event)">

            <div class="form-group">

                <label>Monthly Budget</label>

                <input
                    type="number"
                    id="newBudget"
                    min="1"
                    placeholder="Enter amount"
                    required />

            </div>

            <div class="modal-actions">

                <button
                    type="button"
                    class="secondary-btn"
                    onclick="closeBudgetModal()">
                    Cancel
                </button>

                <button
                    type="submit"
                    class="primary-btn">
                    Save Budget
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        window.serverData = {
            totalSpent: @(ViewBag.TotalSpentRaw),
            budget: @(ViewBag.BudgetRaw),
            transactionCount: @((int)(ViewBag.TransactionCount ?? 0)),
            topCategory: "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.TopCategory))"
        };
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
