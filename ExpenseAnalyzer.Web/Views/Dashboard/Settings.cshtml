@{
    ViewData["Title"] = "Settings";
}

<div class="expense-page">

    <div class="page-heading">
        <div>
            <h1>Settings</h1>
            <p>Your SpendWise account details.</p>
        </div>
    </div>

    <div class="summary-grid">

        <div class="summary-card">
            <div class="card-top">
                <span>Name</span>
                <div class="card-icon blue">👤</div>
            </div>
            <h2>@ViewBag.UserName</h2>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Email</span>
                <div class="card-icon green">✉</div>
            </div>
            <h2 style="font-size:1.1rem;">@ViewBag.UserEmail</h2>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Monthly Budget</span>
                <div class="card-icon orange">₹</div>
            </div>
            <h2>@(string.Format("{0:N0}", ViewBag.BudgetAmount ?? 0m))</h2>
            <p><button class="mini-link" onclick="window.location.href='/Dashboard/Budget'">Manage budget</button></p>
        </div>

    </div>

    <div class="expense-card">
        <div class="expense-card-header">
            <div>
                <h3>Session</h3>
                <p>You are signed in with a secure token that expires after 2 hours.</p>
            </div>
        </div>
        <div style="padding: 16px;">
            <a href="/Account/Logout" class="secondary-btn" style="text-decoration:none; display:inline-block; padding:10px 18px;">
                Sign out
            </a>
        </div>
    </div>

</div>
