@{
    ViewData["Title"] = "Alerts";
}

<div class="dashboard">

    <div class="page-heading">
        <div>
            <h1>Alerts</h1>
            <p>Important notifications about your spending.</p>
        </div>
    </div>

    <div class="alert-list">

        <div class="dashboard-alert warning-alert">
            <div class="dashboard-alert-icon">!</div>

            <div>
                <strong>80% Budget Warning</strong>
                <p>
                    You have used 83% of your monthly budget.
                    ₹2,550 remains.
                </p>
            </div>
        </div>

        <div class="dashboard-alert danger-alert">
            <div class="dashboard-alert-icon">!</div>

            <div>
                <strong>Prediction Warning</strong>
                <p>
                    Your predicted monthly spending is ₹17,800,
                    which is above your ₹15,000 budget.
                </p>
            </div>
        </div>

        <div class="dashboard-alert success-alert">
            <div class="dashboard-alert-icon">✓</div>

            <div>
                <strong>Expense Tracking Active</strong>
                <p>
                    Your expenses are being tracked for August 2026.
                </p>
            </div>
        </div>

    </div>

</div>
