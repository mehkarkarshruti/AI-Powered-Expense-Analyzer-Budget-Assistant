@{
    ViewData["Title"] = "Alerts";
}

<div class="dashboard">

    <div class="page-heading">
        <div>
            <h1>Alerts</h1>
            <p>Important notifications about your spending.</p>
        </div>
    </div>

    <div class="alert-list">

        @if (ViewBag.Alerts is List<string> { Count: > 0 } alerts)
        {
            @foreach (var alert in alerts)
            {
                <div class="dashboard-alert warning-alert">
                    <div class="dashboard-alert-icon">!</div>

                    <div>
                        <strong>Budget Alert</strong>
                        <p>@alert</p>
                    </div>
                </div>
            }
        }

        @if (ViewBag.PredictionWarning is string warning)
        {
            <div class="dashboard-alert danger-alert">
                <div class="dashboard-alert-icon">!</div>

                <div>
                    <strong>Prediction Warning</strong>
                    <p>@warning</p>
                </div>
            </div>
        }

        @if ((ViewBag.Alerts is List<string> a && a.Count == 0) && ViewBag.PredictionWarning is null)
        {
            @if ((bool)ViewBag.HasExpenses)
            {
                <div class="dashboard-alert success-alert">
                    <div class="dashboard-alert-icon">✓</div>

                    <div>
                        <strong>All Good</strong>
                        <p>
                            No budget alerts for @ViewBag.MonthLabel.
                            You are within your spending limits.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="dashboard-alert success-alert">
                    <div class="dashboard-alert-icon">✓</div>

                    <div>
                        <strong>No Alerts Yet</strong>
                        <p>
                            Add expenses and set a monthly budget to
                            start receiving spending alerts.
                        </p>
                    </div>
                </div>
            }
        }

    </div>

</div>
