@{
    ViewData["Title"] = "Prediction";
}

<div class="dashboard">

    <div class="page-heading">
        <div>
            <h1>AI Spending Prediction</h1>
            <p>Forecast your expected monthly spending.</p>
        </div>
    </div>

    <div class="summary-grid">

        <div class="summary-card">
            <div class="card-top">
                <span>Current Spending</span>
                <div class="card-icon purple">₹</div>
            </div>
            <h2>@ViewBag.CurrentSpent</h2>
            <p>This month</p>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Predicted Spending</span>
                <div class="card-icon orange">↗</div>
            </div>
            <h2>@ViewBag.Predicted</h2>
            <p>Expected monthly total</p>
        </div>

        <div class="summary-card">
            <div class="card-top">
                <span>Budget</span>
                <div class="card-icon blue">₹</div>
            </div>
            <h2>@ViewBag.BudgetFormatted</h2>
            <p>Monthly limit</p>
        </div>

    </div>

    <div class="prediction-card prediction-large">

        <div class="prediction-header">
            <div class="prediction-icon">🔮</div>

            <div>
                <h3>Prediction Result</h3>
                <p>Based on historical and current spending patterns.</p>
            </div>
        </div>

        @if ((bool)ViewBag.HasPrediction)
        {
            <div class="prediction-value">
                <span>Expected monthly spending</span>
                <strong>@ViewBag.Predicted</strong>
            </div>

            @if ((bool)ViewBag.Exceeds)
            {
                <div class="prediction-warning">
                    ⚠ The predicted spending is above your budget.
                    Consider reducing discretionary spending.
                </div>
            }
            else
            {
                <div class="prediction-warning">
                    ✓ You are projected to stay within your budget this month.
                </div>
            }
        }
        else
        {
            <p class="empty-state" style="padding: 24px 0;">
                No prediction is available yet. Record expenses and set a
                monthly budget — the forecast appears once there is enough
                spending history.
            </p>
        }

    </div>

</div>
